{
  "$comment": "Blender asset pipeline: generators run headless, exports are optimised into content/.",
  "generators": [
    {
      "script": "blocks.py",
      "outputs": [
        {
          "from": "assets/blender/exports/blocks",
          "to": "content/shared/blocks"
        }
      ]
    },
    {
      "script": "foundry_kit.py",
      "outputs": [
        {
          "from": "assets/blender/exports/foundry",
          "to": "content/stages/ember-foundry/models"
        }
      ]
    },
    {
      "script": "creatures.py",
      "outputs": [
        {
          "from": "assets/blender/exports/creatures",
          "to": "content/shared/creatures"
        }
      ]
    },
    {
      "script": "desert_kit.py",
      "outputs": [
        {
          "from": "assets/blender/exports/desert",
          "to": "content/stages/moving-sands/models"
        }
      ]
    },
    {
      "script": "pyramids.py",
      "outputs": [
        {
          "from": "assets/blender/exports/pyramids",
          "to": "content/stages/moving-sands/models"
        }
      ]
    },
    {
      "script": "flora_kit.py",
      "outputs": [
        {
          "from": "assets/blender/exports/flora",
          "to": "content/shared/flora"
        }
      ]
    },
    {
      "script": "ice_kit.py",
      "outputs": [
        {
          "from": "assets/blender/exports/ice",
          "to": "content/stages/frozen-kingdom/models"
        }
      ]
    },
    {
      "script": "japan_kit.py",
      "outputs": [
        {
          "from": "assets/blender/exports/japan",
          "to": "content/stages/ancient-garden/models"
        }
      ]
    }
  ]
}
