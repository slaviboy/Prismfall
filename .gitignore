node_modules/
dist/
dist-test/
# Private test builds for parallel captures (stage-shots --dist)
dist-*/
coverage/
test-results/
playwright-report/
blob-report/
perf-results/*.json
!perf-results/.gitkeep
*.blend1
*.blend2
.vite/
*.log
.DS_Store
Thumbs.db
.env
.env.*
.claude/*.lock

# Reference screenshots and screen recordings of other games: local study material only, never committed
reference-capture/

# External photoscans (npm run assets:scans): the original downloads in assets/external/ are kept as
# sources of record; the intermediate Blender exports are rebuilt from them.
assets/blender/exports/scans/*.glb

# Full-resolution HDRIs downloaded to build panorama detail bands (large; URLs and MD5s are in source.json).
assets/external/polyhaven/*/*.hdr

# ESO's all-sky TIFF (29 MB) behind the Deep Cosmos sky; URL and MD5 are in its source.json.
assets/external/eso/*/*.tif
